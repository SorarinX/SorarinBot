{
  "name": "sorarinbot",
  "version": "3.0.1",
  "license": "AGPL-3.0-only",
  "description": "SorarinBot - WeChat AI Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.sorarin.bot",
    "productName": "SorarinBot",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "logo.png",
      "!config.yaml",
      "!node_modules",
      "!*.zip",
      "!data.db",
      "!release",
      "!web_dist",
      "!dist"
    ],
    "extraResources": [
      {
        "from": "SorarinBot.exe",
        "to": "SorarinBot.exe"
      }
    ],
    "electronVersion": "33.4.11",
    "electronDist": "dist",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SorarinBot",
      "artifactName": "SorarinBot-${version}-Setup-payload.${ext}",
      "include": "../installer/payload/sorarinbot.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.15.3"
  }
}
