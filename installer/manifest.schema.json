{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sorarinx.github.io/SorarinBot/installer-manifest.schema.json",
  "title": "SorarinBot installer manifest",
  "type": "object",
  "required": [
    "schema",
    "version",
    "payload",
    "minBootstrapper"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "mirrors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          },
          "default": []
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "minBootstrapper": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "notesUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "update": {
      "type": "object",
      "properties": {
        "baseUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "body": {
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
